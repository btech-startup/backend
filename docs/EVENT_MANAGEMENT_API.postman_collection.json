{
  "info": {
    "name": "Event Management API (Vendor + User Experience)",
    "description": "Complete collection for Event Management platform: Vendor Onboarding, KYC, Price Cards, User Experience, Banking Details, and Chatbot Deal Negotiation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleVendorId",
      "value": "70421caf-a7ef-4cad-9960-48ba6fabf7a7",
      "type": "string"
    },
    {
      "key": "samplePriceCardId",
      "value": "pc-royal-decor-01",
      "type": "string"
    },
    {
      "key": "sampleDealId",
      "value": "deal-sample-wedding-royal-01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Experience & Directory",
      "item": [
        {
          "name": "Get Sample Vendors (Testing Helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/sample-vendors",
              "host": ["{{baseUrl}}"],
              "path": ["user", "sample-vendors"]
            }
          }
        },
        {
          "name": "Browse Vendors Directory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/vendors?category=DECORATION&city=Bangalore",
              "host": ["{{baseUrl}}"],
              "path": ["user", "vendors"],
              "query": [
                { "key": "category", "value": "DECORATION" },
                { "key": "city", "value": "Bangalore" }
              ]
            }
          }
        },
        {
          "name": "Get Vendor Public Profile (With Integration Values)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/vendors/{{sampleVendorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "vendors", "{{sampleVendorId}}"]
            }
          }
        },
        {
          "name": "Get Vendor Verified Banking Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/vendors/{{sampleVendorId}}/banking",
              "host": ["{{baseUrl}}"],
              "path": ["user", "vendors", "{{sampleVendorId}}", "banking"]
            }
          }
        },
        {
          "name": "Get Vendor Monthly Calendar (Bearer Token Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/vendors/{{sampleVendorId}}/calendar?month=2026-12",
              "host": ["{{baseUrl}}"],
              "path": ["user", "vendors", "{{sampleVendorId}}", "calendar"],
              "query": [
                {
                  "key": "month",
                  "value": "2026-12"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Date Availability (Bearer Token Required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/vendors/{{sampleVendorId}}/calendar/verify-date?date=2026-12-15",
              "host": ["{{baseUrl}}"],
              "path": ["user", "vendors", "{{sampleVendorId}}", "calendar", "verify-date"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-12-15"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Chatbot & Deal Negotiation",
      "item": [
        {
          "name": "Initiate Deal with Chatbot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"{{sampleVendorId}}\",\n  \"priceCardId\": \"{{samplePriceCardId}}\",\n  \"clientName\": \"Aisha Kapoor\",\n  \"clientPhone\": \"+919811122233\",\n  \"clientEmail\": \"aisha.kapoor@example.com\",\n  \"eventType\": \"Wedding & Reception\",\n  \"eventDate\": \"2026-12-15\",\n  \"guestCount\": 500,\n  \"offeredPrice\": 75000,\n  \"userMessage\": \"Hi! We love your Royal Mandap decor. Can you offer a package discount to ₹75,000 for our 500-guest wedding?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/deals/chatbot",
              "host": ["{{baseUrl}}"],
              "path": ["user", "deals", "chatbot"]
            }
          }
        },
        {
          "name": "Multi-turn Chatbot Negotiation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userMessage\": \"Can we lock in at ₹75,000 if we pay the 30% advance deposit today?\",\n  \"counterOffer\": 75000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/deals/{{sampleDealId}}/negotiate",
              "host": ["{{baseUrl}}"],
              "path": ["user", "deals", "{{sampleDealId}}", "negotiate"]
            }
          }
        },
        {
          "name": "Get Deal Details & Banking Settlement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/deals/{{sampleDealId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "deals", "{{sampleDealId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Vendor Authentication",
      "item": [
        {
          "name": "Send Mobile OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876500001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Mobile OTP & Get JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876500001\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Vendor KYC Verification",
      "item": [
        {
          "name": "Send Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaarNumber\": \"998877665544\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/kyc/aadhaar/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "kyc", "aadhaar", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaarNumber\": \"998877665544\",\n  \"otp\": \"123456\",\n  \"fullName\": \"Vikram Sharma\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/kyc/aadhaar/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "kyc", "aadhaar", "verify-otp"]
            }
          }
        },
        {
          "name": "Verify PAN Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"panNumber\": \"ABCDE1234F\",\n  \"panHolderName\": \"Vikram Sharma\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/kyc/pan/verify",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "kyc", "pan", "verify"]
            }
          }
        },
        {
          "name": "Verify Bank Penny Drop",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"9182736450192\",\n  \"ifsc\": \"HDFC0001234\",\n  \"accountHolderName\": \"Vikram Sharma\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/kyc/bank/verify",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "kyc", "bank", "verify"]
            }
          }
        },
        {
          "name": "Get KYC Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/kyc/status",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "kyc", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Vendor Price Cards",
      "item": [
        {
          "name": "Create Price Card Package",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Royal Mandap & Floral Stage Decor Package\",\n  \"category\": \"DECORATION\",\n  \"price\": 85000,\n  \"pricingUnit\": \"PER_EVENT\",\n  \"inclusions\": [\"Floral backdrop\", \"Red carpet walkway\", \"Spotlights\"],\n  \"terms\": \"30% advance on booking, 70% on event morning.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/price-card",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "price-card"]
            }
          }
        },
        {
          "name": "List Vendor Price Cards",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/price-card",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "price-card"]
            }
          }
        },
        {
          "name": "Public Client View of Price Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/price-card/public/{{sampleVendorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "price-card", "public", "{{sampleVendorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Vendor Calendar & Availability",
      "item": [
        {
          "name": "Get Vendor Calendar Schedule (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/calendar?month=2026-12",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "calendar"],
              "query": [
                {
                  "key": "month",
                  "value": "2026-12"
                }
              ]
            }
          }
        },
        {
          "name": "Block Date(s) on Calendar (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-12-18\",\n  \"title\": \"Warehouse Maintenance & Prop Painting\",\n  \"eventType\": \"MAINTENANCE\",\n  \"notes\": \"Annual refurbishing of wedding mandap props\",\n  \"slotType\": \"FULL_DAY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/calendar/block",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "calendar", "block"]
            }
          }
        },
        {
          "name": "Quick Verify Date (Vendor Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/calendar/verify-date?date=2026-12-15",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "calendar", "verify-date"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-12-15"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
